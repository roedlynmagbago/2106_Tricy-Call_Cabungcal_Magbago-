rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function contactPath(bookingId) {
      return /databases/$(database)/documents/bookingContacts/$(bookingId);
    }

    function driverActivePath(driverId) {
      return /databases/$(database)/documents/driverActiveBookings/$(driverId);
    }

    function passengerActivePath(passengerId) {
      return /databases/$(database)/documents/passengerActiveBookings/$(passengerId);
    }

    function activeRole(role) {
      return signedIn()
        && exists(userPath())
        && get(userPath()).data.role == role
        && get(userPath()).data.status == "ACTIVE";
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath())
        && get(userPath()).data.role in ["ADMIN", "SUPER_ADMIN"]
        && get(userPath()).data.status == "ACTIVE";
    }

    function isSuperAdmin() {
      return activeRole("SUPER_ADMIN");
    }

    function isApprovedDriver() {
      return activeRole("DRIVER")
        && get(userPath()).data.driverApplicationStatus == "APPROVED";
    }

    function isBookingPassenger(bookingId) {
      return signedIn()
        && exists(contactPath(bookingId))
        && get(contactPath(bookingId)).data.passengerId == request.auth.uid;
    }

    // CHECK IF PASSENGER HAS AN ACCEPTED BOOKING WITH DRIVER

    function isPassengerAssignedToDriver(driverId) {
      return activeRole("PASSENGER")
        && exists(passengerActivePath(request.auth.uid))
        && get(passengerActivePath(request.auth.uid)).data.passengerId == request.auth.uid
        && get(passengerActivePath(request.auth.uid)).data.bookingId is string
        && exists(bookingPath(
          get(passengerActivePath(request.auth.uid)).data.bookingId
        ))
        && get(bookingPath(
          get(passengerActivePath(request.auth.uid)).data.bookingId
        )).data.status == "ACCEPTED"
        && get(bookingPath(
          get(passengerActivePath(request.auth.uid)).data.bookingId
        )).data.driverId == driverId
        && exists(contactPath(
          get(passengerActivePath(request.auth.uid)).data.bookingId
        ))
        && get(contactPath(
          get(passengerActivePath(request.auth.uid)).data.bookingId
        )).data.passengerId == request.auth.uid;
    }

    // CHECK COMPLETED RIDE

    function isCompletedRideForPassenger(bookingId, driverId) {
      return signedIn()
        && exists(bookingPath(bookingId))
        && exists(contactPath(bookingId))
        && get(contactPath(bookingId)).data.passengerId == request.auth.uid
        && get(bookingPath(bookingId)).data.status == "COMPLETED"
        && get(bookingPath(bookingId)).data.driverId == driverId;
    }

    // USERS

    match /users/{userId} {

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "userId",
          "name",
          "username",
          "email",
          "phoneNumber",
          "role",
          "status",
          "driverApplicationStatus",
          "toda",
          "address"
        ])
        && request.resource.data.keys().hasAll([
          "userId",
          "name",
          "username",
          "email",
          "phoneNumber",
          "role",
          "status",
          "driverApplicationStatus",
          "toda",
          "address"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.username is string
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phoneNumber is string
        && request.resource.data.toda is string
        && request.resource.data.address is string
        && request.resource.data.role == "PASSENGER"
        && request.resource.data.status == "ACTIVE"
        && request.resource.data.driverApplicationStatus in ["NONE", "PENDING"];

      // READ USER INFORMATION

      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || isPassengerAssignedToDriver(userId)
        );

      allow list: if isAdmin();

      // UPDATE USER INFORMATION

      allow update: if (

        // USER UPDATES OWN PROFILE
        (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "name",
              "username",
              "phoneNumber"
            ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.username is string
          && request.resource.data.username.size() > 0
          && request.resource.data.phoneNumber is string
          && (
            request.resource.data.phoneNumber == ""
            || request.resource.data.phoneNumber.matches("^09[0-9]{9}$")
          )
        )

        ||

        // PASSENGER SUBMITS DRIVER APPLICATION
        (
          signedIn()
          && request.auth.uid == userId
          && resource.data.role == "PASSENGER"
          && resource.data.status == "ACTIVE"
          && resource.data.driverApplicationStatus == "NONE"
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "driverApplicationStatus"
            ])
          && request.resource.data.driverApplicationStatus == "PENDING"
        )

        ||

        // ADMIN APPROVES OR REJECTS DRIVER
        (
          isAdmin()
          && request.auth.uid != userId
          && resource.data.role == "PASSENGER"
          && resource.data.status == "ACTIVE"
          && resource.data.driverApplicationStatus == "PENDING"
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "role",
              "driverApplicationStatus"
            ])
          && (
            (
              request.resource.data.role == "DRIVER"
              && request.resource.data.driverApplicationStatus == "APPROVED"
            )
            ||
            (
              request.resource.data.role == "PASSENGER"
              && request.resource.data.driverApplicationStatus == "REJECTED"
            )
          )
        )

        ||

        // SUPER ADMIN ASSIGNS ADMIN ROLE
        (
          isSuperAdmin()
          && request.auth.uid != userId
          && resource.data.role == "PASSENGER"
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["role"])
          && request.resource.data.role == "ADMIN"
        )
      );

      allow delete: if false;
    }

    // BOOKINGS

    match /bookings/{bookingId} {

      // PASSENGER CREATES BOOKING
      allow create: if activeRole("PASSENGER")
        && request.resource.data.keys().hasOnly([
          "bookingId",
          "pickupLocation",
          "pickupLatitude",
          "pickupLongitude",
          "destination",
          "destinationLatitude",
          "destinationLongitude",
          "driverId",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "bookingId",
          "pickupLocation",
          "pickupLatitude",
          "pickupLongitude",
          "destination",
          "destinationLatitude",
          "destinationLongitude",
          "driverId",
          "status",
          "createdAt"
        ])
        && request.resource.data.bookingId == bookingId
        && request.resource.data.status == "PENDING"
        && request.resource.data.driverId == ""
        && request.resource.data.pickupLocation is string
        && request.resource.data.pickupLocation.size() > 0
        && request.resource.data.destination is string
        && request.resource.data.destination.size() > 0
        && request.resource.data.pickupLatitude is number
        && request.resource.data.pickupLongitude is number
        && request.resource.data.destinationLatitude is number
        && request.resource.data.destinationLongitude is number
        && request.resource.data.pickupLatitude >= -90
        && request.resource.data.pickupLatitude <= 90
        && request.resource.data.pickupLongitude >= -180
        && request.resource.data.pickupLongitude <= 180
        && request.resource.data.destinationLatitude >= -90
        && request.resource.data.destinationLatitude <= 90
        && request.resource.data.destinationLongitude >= -180
        && request.resource.data.destinationLongitude <= 180
        && !(request.resource.data.pickupLatitude == 0
          && request.resource.data.pickupLongitude == 0)
        && !(request.resource.data.destinationLatitude == 0
          && request.resource.data.destinationLongitude == 0)
        && request.resource.data.createdAt is number
        && getAfter(contactPath(bookingId)).data.passengerId == request.auth.uid
        && !exists(passengerActivePath(request.auth.uid))
        && getAfter(passengerActivePath(request.auth.uid)).data.bookingId == bookingId
        && getAfter(passengerActivePath(request.auth.uid)).data.passengerId == request.auth.uid;

      // READ BOOKING
      allow get: if isAdmin()
        || isBookingPassenger(bookingId)
        || (
          isApprovedDriver()
          && (
            (
              resource.data.status == "PENDING"
              && resource.data.driverId == ""
            )
            ||
            (
              resource.data.status == "ACCEPTED"
              && resource.data.driverId == request.auth.uid
            )
          )
        );

      // QUERY AVAILABLE BOOKINGS
      allow list: if isAdmin()
        || (
          isApprovedDriver()
          && resource.data.status == "PENDING"
          && resource.data.driverId == ""
        );

      // UPDATE BOOKING
      allow update: if (

        // DRIVER ACCEPTS BOOKING
        (
          isApprovedDriver()
          && resource.data.status == "PENDING"
          && resource.data.driverId == ""
          && request.resource.data.status == "ACCEPTED"
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["status", "driverId"])
          && !exists(driverActivePath(request.auth.uid))
          && getAfter(driverActivePath(request.auth.uid)).data.bookingId == bookingId
          && getAfter(driverActivePath(request.auth.uid)).data.driverId == request.auth.uid
        )

        ||

        // DRIVER COMPLETES BOOKING
        (
          isApprovedDriver()
          && resource.data.status == "ACCEPTED"
          && resource.data.driverId == request.auth.uid
          && request.resource.data.status == "COMPLETED"
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["status"])
          && exists(contactPath(bookingId))
          && get(contactPath(bookingId)).data.passengerId is string
          && exists(driverActivePath(request.auth.uid))
          && get(driverActivePath(request.auth.uid)).data.bookingId == bookingId
          && exists(passengerActivePath(
            get(contactPath(bookingId)).data.passengerId
          ))
          && get(passengerActivePath(
            get(contactPath(bookingId)).data.passengerId
          )).data.bookingId == bookingId
          && get(passengerActivePath(
            get(contactPath(bookingId)).data.passengerId
          )).data.passengerId == get(contactPath(bookingId)).data.passengerId
          && !existsAfter(driverActivePath(request.auth.uid))
          && !existsAfter(passengerActivePath(
            get(contactPath(bookingId)).data.passengerId
          ))
        )

        ||

        // PASSENGER CANCELS PENDING BOOKING
        (
          activeRole("PASSENGER")
          && isBookingPassenger(bookingId)
          && resource.data.status == "PENDING"
          && resource.data.driverId == ""
          && request.resource.data.status == "CANCELLED"
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["status"])
          && exists(passengerActivePath(request.auth.uid))
          && get(passengerActivePath(request.auth.uid)).data.bookingId == bookingId
          && get(passengerActivePath(request.auth.uid)).data.passengerId == request.auth.uid
          && !existsAfter(passengerActivePath(request.auth.uid))
        )
      );

      allow delete: if false;
    }

    // BOOKING CONTACTS

    match /bookingContacts/{bookingId} {

      allow create: if activeRole("PASSENGER")
        && request.resource.data.keys().hasOnly([
          "bookingId",
          "passengerId",
          "passengerName",
          "passengerPhone"
        ])
        && request.resource.data.keys().hasAll([
          "bookingId",
          "passengerId",
          "passengerName",
          "passengerPhone"
        ])
        && request.resource.data.bookingId == bookingId
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.passengerName is string
        && request.resource.data.passengerName == get(userPath()).data.name
        && request.resource.data.passengerPhone is string
        && request.resource.data.passengerPhone.matches("^09[0-9]{9}$")
        && getAfter(bookingPath(bookingId)).data.bookingId == bookingId;

      allow get: if signedIn()
        && (
          resource.data.passengerId == request.auth.uid
          || isAdmin()
          || (
            isApprovedDriver()
            && exists(bookingPath(bookingId))
            && get(bookingPath(bookingId)).data.driverId == request.auth.uid
            && get(bookingPath(bookingId)).data.status == "ACCEPTED"
          )
        );

      allow list: if false;
      allow update, delete: if false;
    }

    // DRIVER ACTIVE BOOKINGS

    match /driverActiveBookings/{driverId} {

      allow get: if signedIn()
        && (
          request.auth.uid == driverId
          || isAdmin()
        );

      allow list: if false;

      allow create: if isApprovedDriver()
        && request.auth.uid == driverId
        && request.resource.data.keys().hasOnly([
          "bookingId",
          "driverId"
        ])
        && request.resource.data.keys().hasAll([
          "bookingId",
          "driverId"
        ])
        && request.resource.data.driverId == driverId
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && exists(bookingPath(request.resource.data.bookingId))
        && get(bookingPath(request.resource.data.bookingId)).data.status == "PENDING"
        && get(bookingPath(request.resource.data.bookingId)).data.driverId == ""
        && getAfter(bookingPath(request.resource.data.bookingId)).data.status == "ACCEPTED"
        && getAfter(bookingPath(request.resource.data.bookingId)).data.driverId == driverId;

      allow delete: if isApprovedDriver()
        && request.auth.uid == driverId
        && resource.data.driverId == driverId
        && resource.data.bookingId is string
        && get(bookingPath(resource.data.bookingId)).data.status == "ACCEPTED"
        && get(bookingPath(resource.data.bookingId)).data.driverId == driverId
        && getAfter(bookingPath(resource.data.bookingId)).data.status == "COMPLETED";
    }

    // PASSENGER ACTIVE BOOKINGS

    match /passengerActiveBookings/{passengerId} {

      allow get: if signedIn()
        && (
          request.auth.uid == passengerId
          || isAdmin()
          || (
            isApprovedDriver()
            && resource.data.bookingId is string
            && exists(contactPath(resource.data.bookingId))
            && get(contactPath(resource.data.bookingId)).data.passengerId == passengerId
            && exists(bookingPath(resource.data.bookingId))
            && get(bookingPath(resource.data.bookingId)).data.driverId == request.auth.uid
            && get(bookingPath(resource.data.bookingId)).data.status == "ACCEPTED"
          )
        );

      allow list: if false;

      allow create: if activeRole("PASSENGER")
        && request.auth.uid == passengerId
        && request.resource.data.keys().hasOnly([
          "bookingId",
          "passengerId"
        ])
        && request.resource.data.keys().hasAll([
          "bookingId",
          "passengerId"
        ])
        && request.resource.data.passengerId == passengerId
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && !exists(bookingPath(request.resource.data.bookingId))
        && getAfter(bookingPath(request.resource.data.bookingId)).data.status == "PENDING"
        && getAfter(contactPath(request.resource.data.bookingId)).data.passengerId == passengerId;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.passengerId == passengerId
        && resource.data.bookingId is string
        && (

          // PASSENGER CANCELS BOOKING
          (
            request.auth.uid == passengerId
            && activeRole("PASSENGER")
            && get(bookingPath(resource.data.bookingId)).data.status == "PENDING"
            && get(bookingPath(resource.data.bookingId)).data.driverId == ""
            && getAfter(bookingPath(resource.data.bookingId)).data.status == "CANCELLED"
          )

          ||

          // DRIVER COMPLETES BOOKING
          (
            isApprovedDriver()
            && get(bookingPath(resource.data.bookingId)).data.status == "ACCEPTED"
            && get(bookingPath(resource.data.bookingId)).data.driverId == request.auth.uid
            && getAfter(bookingPath(resource.data.bookingId)).data.status == "COMPLETED"
          )
        );
    }

    // DRIVER AVAILABILITY

    match /driverAvailability/{driverId} {

      allow create, update: if isApprovedDriver()
        && request.auth.uid == driverId
        && request.resource.data.keys().hasOnly([
          "driverId",
          "isOnline",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "driverId",
          "isOnline",
          "updatedAt"
        ])
        && request.resource.data.driverId == driverId
        && request.resource.data.isOnline is bool
        && request.resource.data.updatedAt is number;

      allow get: if isAdmin()
        || (
          isApprovedDriver()
          && request.auth.uid == driverId
        )
        || isPassengerAssignedToDriver(driverId)
        || (
          activeRole("PASSENGER")
          && resource.data.isOnline == true
        );

      allow list: if activeRole("PASSENGER")
        && resource.data.isOnline == true;

      allow delete: if false;
    }

    // DRIVER LOCATIONS

    match /driverLocations/{driverId} {

      allow create, update: if isApprovedDriver()
        && request.auth.uid == driverId
        && request.resource.data.keys().hasOnly([
          "driverId",
          "latitude",
          "longitude",
          "accuracy",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "driverId",
          "latitude",
          "longitude",
          "accuracy",
          "updatedAt"
        ])
        && request.resource.data.driverId == driverId
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0
        && request.resource.data.updatedAt is number;

      allow get: if isAdmin()
        || isPassengerAssignedToDriver(driverId);

      allow list: if false;
      allow delete: if false;
    }

    // DRIVER RATINGS

    match /driverRatings/{bookingId} {

      allow create: if activeRole("PASSENGER")
        && request.resource.data.keys().hasOnly([
          "ratingId",
          "bookingId",
          "passengerId",
          "driverId",
          "rating",
          "comment",
          "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "ratingId",
          "bookingId",
          "passengerId",
          "driverId",
          "rating",
          "comment",
          "createdAt"
        ])
        && request.resource.data.ratingId == bookingId
        && request.resource.data.bookingId == bookingId
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.driverId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt is number
        && isCompletedRideForPassenger(
          bookingId,
          request.resource.data.driverId
        );

      allow get, list: if isAdmin()
        || activeRole("PASSENGER")
        || isApprovedDriver();

      allow update, delete: if false;
    }

    // DRIVER REPORTS

    match /driverReports/{reportId} {

      allow create: if activeRole("PASSENGER")
        && request.resource.data.keys().hasOnly([
          "reportId",
          "bookingId",
          "passengerId",
          "driverId",
          "category",
          "description",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "reportId",
          "bookingId",
          "passengerId",
          "driverId",
          "category",
          "description",
          "status",
          "createdAt"
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.bookingId is string
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.driverId is string
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status == "PENDING"
        && request.resource.data.createdAt is number
        && isCompletedRideForPassenger(
          request.resource.data.bookingId,
          request.resource.data.driverId
        );

      allow get, list: if isAdmin();

      allow update, delete: if false;
    }

    // TRICYCLE STANDS

    match /tricycleStands/{standId} {

      allow get, list: if true;

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "standId",
          "name",
          "latitude",
          "longitude",
          "type",
          "isActive"
        ])
        && request.resource.data.keys().hasAll([
          "standId",
          "name",
          "latitude",
          "longitude",
          "type",
          "isActive"
        ])
        && request.resource.data.standId == standId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.type in ["SAKAYAN", "BABAAAN"]
        && request.resource.data.isActive is bool;

      allow delete: if false;
    }

    // NO-PARKING ZONES

    match /noParkingZones/{zoneId} {

      allow get, list: if true;

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "zoneId",
          "name",
          "latitude",
          "longitude",
          "radius",
          "description",
          "isActive"
        ])
        && request.resource.data.keys().hasAll([
          "zoneId",
          "name",
          "latitude",
          "longitude",
          "radius",
          "description",
          "isActive"
        ])
        && request.resource.data.zoneId == zoneId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.radius is number
        && request.resource.data.radius > 0
        && request.resource.data.description is string
        && request.resource.data.isActive is bool;

      allow delete: if false;
    }

    // PARADA SCHEDULES

    match /paradaSchedules/{scheduleId} {

      allow get, list: if true;

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "scheduleId",
          "todaName",
          "standId",
          "openingTime",
          "closingTime",
          "cutOffTime",
          "isActive"
        ])
        && request.resource.data.keys().hasAll([
          "scheduleId",
          "todaName",
          "standId",
          "openingTime",
          "closingTime",
          "cutOffTime",
          "isActive"
        ])
        && request.resource.data.scheduleId == scheduleId
        && request.resource.data.todaName is string
        && request.resource.data.todaName.size() > 0
        && request.resource.data.standId is string
        && request.resource.data.standId.size() > 0
        && request.resource.data.openingTime is string
        && request.resource.data.openingTime.size() > 0
        && request.resource.data.closingTime is string
        && request.resource.data.closingTime.size() > 0
        && request.resource.data.cutOffTime is string
        && request.resource.data.cutOffTime.size() > 0
        && request.resource.data.isActive is bool;

      allow delete: if false;
    }

    // TRICYCLE COUNTS

    match /tricycleCounts/{todaId} {

      allow get, list: if true;

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "todaId",
          "todaName",
          "totalTricycles",
          "availableTricycles",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "todaId",
          "todaName",
          "totalTricycles",
          "availableTricycles",
          "updatedAt"
        ])
        && request.resource.data.todaId == todaId
        && request.resource.data.todaName is string
        && request.resource.data.todaName.size() > 0
        && request.resource.data.totalTricycles is int
        && request.resource.data.totalTricycles >= 0
        && request.resource.data.availableTricycles is int
        && request.resource.data.availableTricycles >= 0
        && request.resource.data.availableTricycles
          <= request.resource.data.totalTricycles
        && request.resource.data.updatedAt is number;

      allow delete: if false;
    }
  }
}